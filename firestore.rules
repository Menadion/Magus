rules_version = '2';

// Who can see what in Mogar. Paste into Firebase console > Firestore Database > Rules > Publish.
//
//   families/{code}                  anyone signed in can check a code exists (to join) or make a new one
//   families/{code}/members/{uid}    only members of that family can read it; you can only write your own
//   feedback/{id}                    anyone signed in can add one; nobody can read them from a phone
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return exists(/databases/$(database)/documents/families/$(code)/members/$(request.auth.uid));
    }

    match /families/{code} {
      // "get" is one family by its code. Listing every family is not allowed.
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // Only whoever made the family can change its name, and only its name.
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      match /members/{uid} {
        allow read: if signedIn() && isMember(code);
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/families/$(code));
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Notes from Settings > Send feedback. A phone can add its own, and no phone can read any.
    // They're read on the laptop by tools/read-feedback.mjs, whose admin key skips these rules.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
