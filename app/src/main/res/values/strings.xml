    <string name="xiaomi_title">Xiaomi: turn on Autostart</string>
    <string name="xiaomi_detail">Tap the button. On the page that opens, turn on Autostart.</string>
    <string name="vivo_title">Vivo: allow background use</string>
    <string name="vivo_detail">Tap the button. Turn on Mogar in the list that opens. If you see App info instead, open Battery and allow high background power use.</string>
    <string name="samsung_title">Samsung: don\'t put Mogar to sleep</string>
    <string name="samsung_detail">Tap the button. Under Background usage limits, turn off \"Put unused apps to sleep\". Then open Never sleeping apps and add Mogar. On an older Samsung this is under Device care, Battery, then the ⋮ menu.</string>
    <string name="pause_title">Don\'t pause Mogar when unused</string>
    <string name="pause_detail">Tap the button, then turn off \"Pause app activity if unused\". Otherwise your phone stops Mogar after a few months without opening it.</string>
