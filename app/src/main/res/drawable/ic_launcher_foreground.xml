<!-- The Mogar logo, from Claude Design (design/handoff/LOGO.md, 2026-09-26): a pebble and its
     ripple, flat. The pebble is a thick blue ring, the same idea as the circles that stand for
     people in the app; under it a lighter blue curve is the ripple on the water. It also reads as a
     head over shoulders. Converted by hand from design/logo/ic_launcher_foreground.svg; the whole
     mark sits inside the 66 dp safe zone of the 108 dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ripple: a circular arc round the pebble's own centre (M's call 2026-09-26, over the
         handoff's ellipse), radius 30 to the middle of the stroke, ends 20 degrees below the
         horizontal. Pebble and ripple are one group, centred vertically: ring top at 29.15, arc
         bottom at 78.9, both 24.85 from the canvas centre. -->
    <path
        android:strokeColor="#FF7C95E2"
        android:strokeWidth="7.37"
        android:strokeLineCap="butt"
        android:pathData="M25.81,55.46 A30,30 0 0 0 82.19,55.46" />
    <!-- pebble -->
    <path
        android:strokeColor="#FF2F55C4"
        android:strokeWidth="7.37"
        android:pathData="M54,32.83 A12.37,12.37 0 1 1 54,57.57 A12.37,12.37 0 1 1 54,32.83 Z" />
</vector>
