    <string name="step_background_other">Pindutin ang button, tapos piliin ang Allow.</string>
    <string name="allow">Payagan</string>
    <string name="xiaomi_title">Xiaomi: i-on ang Autostart</string>
    <string name="xiaomi_detail">Pindutin ang button. Sa page na bubukas, i-on ang Autostart.</string>
    <string name="vivo_title">Vivo: payagan ang background use</string>
    <string name="vivo_detail">Pindutin ang button. I-on ang Mogar sa listahang bubukas. Kung App info ang lumabas, buksan ang Battery at payagan ang high background power use.</string>
    <string name="samsung_title">Samsung: huwag patulugin ang Mogar</string>
    <string name="samsung_detail">Pindutin ang button. Sa ilalim ng Background usage limits, i-off ang \"Put unused apps to sleep\". Tapos buksan ang Never sleeping apps at idagdag ang Mogar. Sa mas lumang Samsung, nasa Device care, Battery, tapos sa ⋮ menu ito.</string>
    <string name="pause_title">Huwag i-pause ang Mogar kapag hindi ginagamit</string>
    <string name="pause_detail">Pindutin ang button, tapos i-off ang \"Pause app activity if unused\". Kung hindi, ititigil ng phone mo ang Mogar pagkatapos ng ilang buwang hindi nabubuksan.</string>
