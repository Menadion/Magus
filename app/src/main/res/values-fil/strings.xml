    <!-- Keep Mogar running -->
    <string name="keep_running_intro">May mga phone na nagsasara ng Mogar para makatipid ng baterya. Kapag nangyari iyon, hindi na makikita ng pamilya mo kung nasaan ka. Gawin ang mga hakbang na ito nang isang beses.</string>
